# WordleRush Backend Configuration

# Server Port
PORT=4000

# Client Application URL (for CORS and Socket.IO origin)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Database Connection URL (Supabase PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
# Direct connection for migrations: postgresql://[user]:[password]@[host]:5432/[database]
DATABASE_URL="postgresql://postgres:your-supabase-password@db.your-project-ref.supabase.co:5432/postgres"

# Game Configuration Defaults
GAME_DURATION_SECONDS=180
MAX_ATTEMPTS=6
MAX_PLAYERS=8
MIN_PLAYERS=2
